{
  "name": "night-sounds",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export": "expo export --platform all",
    "audio:generate": "python3 scripts/generate_audio.py",
    "test:timer": "node --experimental-strip-types scripts/check_timer.mjs",
    "audio:check": "python3 scripts/check_audio.py",
    "build:web": "expo export --platform web && node scripts/build-pwa.mjs",
    "test:pwa": "node scripts/check_pwa.mjs",
    "test:gapless": "node scripts/check_gapless.mjs",
    "test:history": "node scripts/check_history.mjs",
    "test:metadata": "node scripts/check_metadata.mjs",
    "artwork:generate": "node scripts/generate_artwork.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-sensors": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "expo-doctor": "^1.20.4",
    "typescript": "~6.0.3"
  }
}
